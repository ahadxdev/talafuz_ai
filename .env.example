# Frontend
VITE_API_BASE_URL=http://localhost:8000

# Backend
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Phase 2 — Audio extraction + speech recognition (ASR)
# ---------------------------------------------------------------------------

# FFmpeg (system requirement for audio extraction)
# FFMPEG_BIN=ffmpeg
# AUDIO_SAMPLE_RATE=16000

# ASR provider: "none" (not configured) | "alibaba"
ASR_PROVIDER=alibaba

# ---------------------------------------------------------------------------
# Alibaba Cloud Model Studio — Qwen3-ASR
# Authentication uses a Model Studio API key (NOT the legacy access keys).
# API keys are region-specific: the region must match the key's region.
# ---------------------------------------------------------------------------
DASHSCOPE_API_KEY=

# Timestamped async file transcription (recommended): qwen3-asr-flash-filetrans
# Text-only synchronous fallback (NO timestamps): qwen3-asr-flash
ALIBABA_ASR_MODEL=qwen3-asr-flash-filetrans

# Endpoint region: singapore | beijing
ALIBABA_ASR_REGION=singapore

# Optional workspace ID — only set if your account requires the
# workspace-specific domain https://{WorkspaceId}.<region-domain>.
# When empty, the official standard DashScope domain is used.
ALIBABA_WORKSPACE_ID=

# Optional language hint (single code, e.g. hi or en). Leave empty for
# automatic language detection (recommended for code-switched speech).
ALIBABA_ASR_LANGUAGE_HINTS=

# Legacy Alibaba Cloud access keys — NOT used by this integration:
# ALIBABA_CLOUD_ACCESS_KEY_ID=
# ALIBABA_CLOUD_ACCESS_KEY_SECRET=

# ---------------------------------------------------------------------------
# Phase 3 — Romanization + optional English translation
# Uses the same DASHSCOPE_API_KEY and ALIBABA_ASR_REGION as ASR, with a
# Qwen TEXT model via the official OpenAI-compatible endpoint.
# Valid models: qwen-flash, qwen-turbo, qwen-plus, qwen-max
# ---------------------------------------------------------------------------
ROMANIZATION_MODEL=qwen-plus
